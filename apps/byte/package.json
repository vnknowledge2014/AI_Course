{
  "name": "@byte/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run chuan-bi && vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "noi-dung": "node ../../packages/content-compiler/dist/cli.js build ../../content public/noi-dung",
    "pyodide": "node -e \"const p=require('node:path').dirname(require.resolve('pyodide/package.json')),f=require('node:fs');f.mkdirSync('public/pyodide',{recursive:true});for(const n of ['pyodide.asm.js','pyodide.asm.wasm','pyodide.mjs','python_stdlib.zip','pyodide-lock.json'])f.copyFileSync(p+'/'+n,'public/pyodide/'+n)\"",
    "chuan-bi": "pnpm run noi-dung && pnpm run thu-vien && pnpm run pyodide && pnpm run wasm",
    "tauri": "tauri",
    "test": "tsc src/lib/cay_ky_nang.ts src/lib/tien_do.ts --outDir dist-test --module esnext --target es2022 --moduleResolution bundler --skipLibCheck --types vite/client && node --test test/*.test.mjs",
    "thu-vien": "node ../../packages/content-compiler/dist/cli.js legacy ../../content public/thu-vien",
    "wasm": "cargo build --release --target wasm32-unknown-unknown -p byte-rust && node -e \"require('node:fs').mkdirSync('public/wasm',{recursive:true});require('node:fs').copyFileSync('../../target/wasm32-unknown-unknown/release/byte_rust.wasm','public/wasm/byte_rust.wasm')\""
  },
  "dependencies": {
    "@byte/content-schema": "workspace:*",
    "@byte/ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "pyodide": "^0.29.4",
    "@byte/exec-core": "workspace:*",
    "@byte/exec-python": "workspace:*",
    "@byte/exec-rust": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.7"
  }
}