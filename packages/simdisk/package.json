{
  "name": "@byte/simdisk",
  "version": "0.1.0",
  "private": true,
  "description": "Block device mô phỏng cho Realm 6 (Database) — read/write/fsync theo sector, không dùng open() thật. Xem MASTERPLAN.md §4 mục 'SimDisk'.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
